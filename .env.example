# ── 서버리스 함수(api/) 전용. 브라우저에 노출되지 않는다. Vercel 환경변수와 동일한 키 ──
NOTION_TOKEN=            # 노션 통합 시크릿 (ntn_…)
NOTION_DATABASE_ID=3312b50723568075b89fd525e989bc98
NOTION_DATA_SOURCE_ID=3312b507235680b6a97b000b854ed6e6   # 예약. 현재 코드에서는 사용하지 않음

# ── 프론트엔드(vite) 전용. VITE_ 접두사는 브라우저에 노출되므로 비밀값 금지 ──
# `npm run dev`에서 /api 요청을 넘길 주소. 비우면 목업 API로 동작한다.
# 예: Vercel 프리뷰 URL https://wedding-xxxx.vercel.app
VITE_API_PROXY=
